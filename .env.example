# ==============================================================================
# APNA SHOES — ENVIRONMENT CONFIGURATION (PRODUCTION & DEVELOPMENT PLACEHOLDERS)
# Store: APNA SHOES | Tagline: "Har Kadam, Apna Style."
# ==============================================================================

# 1. AI STUDIO RUNTIME INJECTIONS
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"

# 2. SUPABASE / POSTGRESQL DATABASE
# Required for production cloud PostgreSQL database and Supabase Auth & Storage
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"

# 3. RAZORPAY PAYMENT GATEWAY (INDIA)
# Generate from Razorpay Dashboard -> Settings -> API Keys (Test / Live Mode)
# Default sandbox test key provided in development: rzp_test_apnashoes2026
RAZORPAY_KEY_ID="rzp_test_apnashoes2026"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 4. SHIPROCKET COURIER & LOGISTICS API
# Used for automatic Airway Bill (AWB) generation, Delhivery / BlueDart routing, and reverse pickups
SHIPROCKET_EMAIL="logistics@apnashoes.in"
SHIPROCKET_PASSWORD="your_shiprocket_account_password"
SHIPROCKET_API_TOKEN="your_generated_shiprocket_jwt_token"

# 5. GOOGLE MAPS PLATFORM
# Used for customer address autocomplete, location pin-drop, and geocoding
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# 6. TRANSACTIONAL NOTIFICATIONS (RESEND / WHATSAPP / SMS)
# Used for order confirmation, dispatch AWB alerts, and 7-day return pickup updates
RESEND_API_KEY="re_your_resend_api_key"
NOTIFICATION_SENDER_EMAIL="orders@apnashoes.in"
WHATSAPP_BUSINESS_API_KEY="your_whatsapp_gateway_key"

# 7. FLIPKART AUTHORIZED SELLER INTEGRATION (OPTIONAL)
# Used for syncing inventory and ingesting marketplace orders from Flipkart Assured
FLIPKART_APP_ID="your_flipkart_developer_app_id"
FLIPKART_APP_SECRET="your_flipkart_developer_secret"
